             has_negative = True\n        elif p in roman_map:\n            pos_values.append(roman_map[p])\n    \n    if not pos_values:\n        return 0\n        \n    max_pos = max(pos_values)\n    \n    # Aplicación de la lógica de clasificación:\n    # Nota: El usuario distingue entre "any" y "some" negative value. \n    # En lógica booleana, si 'has_negative' es True, se cumplen ambos. \n    # He priorizado los códigos pares para "some" y impares para "any" según el orden de la solicitud.\n\n    if max_pos == 1:\n        return -2 if has_negative else 0 # Si solo hay I y negativo -&gt; -2 (incluye -1)\n    elif max_pos == 2:\n        return -4 if has_negative else 0 # Si solo hay II y negativo -&gt; -4 (incluye -3)\n    elif max_pos &gt;= 3:\n        return -6 if has_negative else 0 # Si hay III o más y negativo -&gt; -6 (incluye -5)\n        \n    return 0"</Process><Process ToolSource="c:\program files (x86)\arcgis\desktop10.8\ArcToolbox\Toolboxes\Data Management Tools.tbx\CalculateField" Date="20260121" Time="103530">CalculateField Catastro\UA\Casas\CONSTRU_UA_v2.1 BT classify_construction(!CONSTRY!) PYTHON_9.3 "def classify_construction(field_value):\n    if field_value is None or field_value == "":\n        return 0\n    \n    # Diccionario para convertir romanos a enteros y poder comparar magnitudes\n    roman_map = {\n        "I": 1, "II": 2, "III": 3, "IV": 4, "V": 5, \n        "VI": 6, "VII": 7, "VIII": 8, "IX": 9, "X": 10,\n        "XI": 11, "XII": 12, "XIII": 13, "XIV": 14, "XV": 15, \n        "XVI": 16, "XVII": 17, "XVIII": 18, "XIX": 19, "XX": 20\n    }\n    \n    # Separar la cadena por el carácter "+"\n    parts = [p.strip() for p in str(field_value).split("+")]\n    \n    pos_values = []\n    has_negative = False\n    \n    for p in parts:\n        # Verificar si es un código negativo (ej: -I, -II)\n        if p.startswith("-"):\n            has_negative = True\n        # Verificar si es un código positivo dentro del mapa romano\n        elif p in roman_map:\n            pos_values.append(roman_map[p])\n            \n    # Si no se detectó ningún código romano positivo, devolvemos 0\n    if not pos_values:\n        return 0\n        \n    max_pos = max(pos_values)\n    \n    # Lógica de Clasificación Final:\n    # Caso 1 y 2: Valor máximo es I (1)\n    if max_pos == 1:\n        return 2 if has_negative else 1\n        \n    # Caso 3 y 4: Valor máximo es II (2)\n    elif max_pos == 2:\n        return 4 if has_negative else 3\n        \n    # Caso 5 y 6: Valor máximo es III o superior (&gt;= 3)\n    elif max_pos &gt;= 3:\n        return 6 if has_negative else 5\n        \n    return 0"</Process><Process ToolSource="c:\program files (x86)\arcgis\desktop10.8\ArcToolbox\Toolboxes\Data Management Tools.tbx\CalculateField" Date="20260121" Time="103603">CalculateField Catastro\UA\Casas\CONSTRU_UA_v2.1 BT 0 VB #</Process><Process ToolSource="c:\program files (x86)\arcgis\desktop10.8\ArcToolbox\Toolboxes\Data Management Tools.tbx\CalculateField" Date="20260121" Time="103725">CalculateField Catastro\UA\Casas\CONSTRU_UA_v2.1 BT classify_construction(!CONSTRY!) PYTHON_9.3 "def classify_construction(field_value):\n    if field_value is None or field_value == "":\n        return 0\n    \n    # Diccionario para convertir romanos a enteros y poder comparar magnitudes\n    roman_map = {\n        "I": 1, "II": 2, "III": 3, "IV": 4, "V": 5, \n        "VI": 6, "VII": 7, "VIII": 8, "IX": 9, "X": 10,\n        "XI": 11, "XII": 12, "XIII": 13, "XIV": 14, "XV": 15, \n        "XVI": 16, "XVII": 17, "XVIII": 18, "XIX": 19, "XX": 20\n    }\n    \n    # Separar la cadena por el carácter "+"\n    parts = [p.strip() for p in str(field_value).split("+")]\n    \n    pos_values = []\n    has_negative = False\n    \n    for p in parts:\n        # Verificar si es un código negativo (ej: -I, -II)\n        if p.startswith("-"):\n            has_negative = True\n        # Verificar si es un código positivo dentro del mapa romano\n        elif 